<% b = @b %>
<% if b and b.kind is 'failed': %>
  <span class="<%= @cls %> is-failed" title="<%- @T('Die Zahl konnte gerade nicht geladen werden, es wird automatisch erneut versucht.') %>">?</span>
<% else if b and b.kind is 'loading': %>
  <span class="<%= @cls %> is-loading" title="<%- @T('Zahlen werden geladen') %>">…</span>
<% else if b: %>
  <% title = if b.hidden > 0 then @T('%s von %s offenen Tickets sind eigene Tickets', b.value, b.total) else @T('offene Tickets') %>
  <span class="<%= @cls %><%= ' is-zero' if b.value is 0 %><%= ' is-stale' if b.stale %>" title="<%- title %>"><%= b.value %></span>
<% end %>
