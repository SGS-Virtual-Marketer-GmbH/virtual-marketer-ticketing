<% if @loading: %>
  <p class="vm-work__qempty"><%- @T('Wird geladen …') %></p>
<% else if !@tickets.length: %>
  <p class="vm-work__qempty">
    <% if @onlyMine: %><%- @T('In dieser Kategorie gibt es keine eigenen Tickets.') %>
    <% else: %><%- @T('Diese Kategorie ist leer, nichts zu tun.') %><% end %>
  </p>
<% else: %>
  <% for ticket in @tickets: %>
    <% signal = App.VmSignal.of(ticket) %>
    <% closed = !signal %>
    <% people = @presence?[ticket.id] or [] %>
    <button type="button" class="vm-work__qi js-vmQueueItem<%= ' is-active' if ticket.id is @ticketId %><%= ' is-done' if closed %>" data-id="<%= ticket.id %>">
      <span class="vm-work__qtop">
        <%- App.VmSignal.badge(signal) %>
        <% if people.length: %>
          <% level = if _.some(people, (p) -> p.editing) then 'editing' else 'viewing' %>
          <span class="vm-work__qpres vm-work__qpres--<%= level %>" title="<%= App.VmWorkspace.presenceTitle(people) %>" aria-label="<%= App.VmWorkspace.presenceTitle(people) %>" role="img"></span>
        <% end %>
        <span class="vm-work__qnr">#<%= ticket.number %></span>
        <span class="vm-work__qage"><%- @humanTime(ticket.created_at) %></span>
      </span>
      <span class="vm-work__qsubj"><%= ticket.title %></span>
      <% if ticket.customer_id and App.User.exists(ticket.customer_id): %>
        <span class="vm-work__qwho"><%= App.User.find(ticket.customer_id).displayName() %></span>
      <% end %>
    </button>
  <% end %>
<% end %>
<% if @hidden: %>
  <p class="vm-work__qhidden">
    <% if @hidden.unassigned is @hidden.count: %>
      <%- @T((if @hidden.count is 1 then '%s weiteres Ticket ausgeblendet, noch niemandem zugewiesen.' else '%s weitere Tickets ausgeblendet, noch niemandem zugewiesen.'), @hidden.count) %>
    <% else if @hidden.unassigned is 0: %>
      <%- @T((if @hidden.count is 1 then '%s weiteres Ticket ausgeblendet, bei Kollegen.' else '%s weitere Tickets ausgeblendet, bei Kollegen.'), @hidden.count) %>
    <% else: %>
      <%- @T((if @hidden.count is 1 then '%s weiteres Ticket ausgeblendet, davon %s noch niemandem zugewiesen.' else '%s weitere Tickets ausgeblendet, davon %s noch niemandem zugewiesen.'), @hidden.count, @hidden.unassigned) %>
    <% end %>
  </p>
<% end %>
