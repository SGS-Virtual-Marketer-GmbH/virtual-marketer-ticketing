<div class="vm-tiles">
  <div class="vm-tiles__intro">
    <h2 class="vm-tiles__headline"><%- @T('Ihre KI-Kollegen') %></h2>
    <p class="vm-tiles__lead">
      <%- @T('Jedes eingehende Ticket wird automatisch eingeordnet, mit echten Daten aus Xentral und der Sendungsverfolgung angereichert und mit einem Antwortvorschlag versehen. Sie prüfen und entscheiden: Verschickt wird nichts ohne Sie.') %>
    </p>
    <div class="vm-tiles__filter">
      <label class="vm-switch">
        <input type="checkbox" class="js-vmOnlyMine"<%= ' checked' if @state.onlyMine %>>
        <span class="vm-switch__track" aria-hidden="true"></span>
        <span class="vm-switch__label"><%- @T('Nur meine Tickets') %></span>
      </label>
      <% summary = App.VmCounts.hiddenSummary(@state) %>
      <% if summary: %>
        <span class="vm-tiles__hidden js-vmHiddenSummary">
          <% if summary.hidden is 0: %>
            <%- @T('Nichts ausgeblendet: Alle offenen Tickets sind eigene Tickets.') %>
          <% else if summary.unassigned is summary.hidden: %>
            <%- @T((if summary.hidden is 1 then '%s weiteres Ticket ausgeblendet, noch niemandem zugewiesen.' else '%s weitere Tickets ausgeblendet, noch niemandem zugewiesen.'), summary.hidden) %>
          <% else if summary.unassigned is 0: %>
            <%- @T((if summary.hidden is 1 then '%s weiteres Ticket ausgeblendet, bei Kollegen.' else '%s weitere Tickets ausgeblendet, bei Kollegen.'), summary.hidden) %>
          <% else: %>
            <%- @T((if summary.hidden is 1 then '%s weiteres Ticket ausgeblendet, davon %s noch niemandem zugewiesen.' else '%s weitere Tickets ausgeblendet, davon %s noch niemandem zugewiesen.'), summary.hidden, summary.unassigned) %>
          <% end %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="vm-tiles__grid">
    <% for tile in @tiles: %>
      <button type="button"
              class="vm-tile js-vmTile<%= ' vm-tile--highlight' if tile.highlight %>"
              data-link="<%= tile.key %>"
              aria-label="<%= @T(tile.name) %>">
        <span class="vm-tile__head">
          <span class="vm-tile__icon"><%- @icon(tile.icon) %></span>
          <span class="vm-tile__name"><%- @T(tile.name) %></span>
          <% badge = App.VmCounts.badge(@state, tile.key) %>
          <%- App.view('vm_count_badge')(cls: 'vm-tile__count', b: badge) %>
        </span>
        <% if badge and badge.kind is 'count' and badge.hidden > 0: %>
          <span class="vm-tile__hidden">
            <% if badge.unassigned > 0: %>
              <%- @T('%s von %s, %s nicht zugewiesen', badge.value, badge.total, badge.unassigned) %>
            <% else: %>
              <%- @T('%s von %s, Rest bei Kollegen', badge.value, badge.total) %>
            <% end %>
          </span>
        <% end %>

        <span class="vm-tile__description"><%- @T(tile.description) %></span>

        <span class="vm-tile__meta">
          <span class="vm-tile__row">
            <span class="vm-tile__label"><%- @T('KANN') %></span>
            <span class="vm-tile__chips">
              <% for item in tile.can: %><span class="vm-tile__chip"><%- @T(item) %></span><% end %>
            </span>
          </span>
          <span class="vm-tile__row">
            <span class="vm-tile__label"><%- @T('SIEHT') %></span>
            <span class="vm-tile__chips">
              <% for item in tile.sees: %><span class="vm-tile__chip vm-tile__chip--source"><%- @T(item) %></span><% end %>
            </span>
          </span>
        </span>
      </button>
    <% end %>
  </div>
</div>
