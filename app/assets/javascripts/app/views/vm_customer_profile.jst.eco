<%# @data comes straight from denta-care-agent's customerProfile.js — field %>
<%# names (kunde/kontakthistorie/auftraege/passenderAuftrag/xentralStatus) %>
<%# are kept in sync with that file on purpose, so a shape change is visible %>
<%# here as missing content rather than a silent wrong render. %>
<div class="vm-profile">
  <% if @loading: %>
    <div class="vm-profile__loading"><%- @T('Lädt …') %></div>
  <% end %>

  <% if @error: %>
    <div class="vm-profile__error"><%= @error %></div>
  <% end %>

  <% if @data: %>
    <% if @data.kunde: %>
      <div class="vm-profile__section vm-profile__customer">
        <div class="vm-profile__name">
          <%= @data.kunde.name %>
          <% if @data.kunde.xentralLink: %>
            <a class="vm-profile__cta" href="<%= @data.kunde.xentralLink %>" target="_blank" rel="noopener"><%- @T('Xentral') %></a>
          <% end %>
        </div>
        <% if @data.kunde.organisation: %>
          <div class="vm-profile__muted"><%= @data.kunde.organisation %></div>
        <% end %>
        <% if @data.kunde.email: %>
          <div class="vm-profile__muted"><%= @data.kunde.email %></div>
        <% end %>
        <% if @data.kunde.telefon: %>
          <div class="vm-profile__muted"><%= @data.kunde.telefon %></div>
        <% end %>
      </div>
    <% end %>

    <% if @data.kontakthistorie and @data.kontakthistorie.anzahlTickets isnt null: %>
      <div class="vm-profile__section">
        <div class="vm-profile__stat">
          <span class="vm-profile__statValue"><%= @data.kontakthistorie.anzahlTickets %></span>
          <span class="vm-profile__statLabel"><%- @T('Kontakte bisher') %></span>
        </div>
      </div>
    <% end %>

    <%# The order THIS ticket is about is more useful than the general order list, so it renders first when we have one -- go-live feedback 2026-09-18. %>
    <% if @data.passenderAuftrag: %>
      <div class="vm-profile__section vm-profile__matched">
        <div class="vm-profile__sectionHead"><%- @T('Passender Auftrag zu diesem Ticket') %></div>
        <div>
          <% if @data.passenderAuftrag.link: %>
            <a class="vm-profile__orderNr" href="<%= @data.passenderAuftrag.link %>" target="_blank" rel="noopener">#<%= @data.passenderAuftrag.auftragsnummer %></a>
          <% else: %>
            <span class="vm-profile__orderNr">#<%= @data.passenderAuftrag.auftragsnummer %></span>
          <% end %>
          <span class="vm-profile__muted"><%= @data.passenderAuftrag.datum %></span>
          <span class="vm-profile__orderTotal"><%= @data.passenderAuftrag.summeFormatiert %></span>
        </div>
        <% if @data.passenderAuftrag.statusText: %>
          <div class="vm-profile__muted"><%- @T('Status') %>: <%= @data.passenderAuftrag.statusText %></div>
        <% end %>
        <% if @data.passenderAuftrag.positionen.length: %>
          <ul class="vm-profile__items">
            <% for item in @data.passenderAuftrag.positionen: %>
              <li>
                <% if item.bild: %>
                  <img class="vm-profile__itemImg" src="<%= item.bild %>" alt="">
                <% end %>
                <%= item.menge %>&times; <%= item.artikel %>
                <% if item.artikelnummer: %>
                  <% if item.link: %>
                    <a class="vm-profile__muted" href="<%= item.link %>" target="_blank" rel="noopener"><%= item.artikelnummer %></a>
                  <% else: %>
                    <span class="vm-profile__muted"><%= item.artikelnummer %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%# Stock per article, where it is booked and what is inbound from open purchase orders: the same data as the internal note and the assistant (denta-care-agent orderStock.js). zulauf null means purchasing could not be read, so nothing is claimed either way. %>
        <% lager = @data.passenderAuftrag.lager %>
        <% if lager and lager.artikel and lager.artikel.length: %>
          <div class="vm-profile__stock">
            <div class="vm-profile__subHead">
              <%- @T('Lager & Zulauf') %>
              <% if lager.versandlager: %><span class="vm-profile__muted">· <%- @T('Versandlager') %> <%= lager.versandlager %></span><% end %>
            </div>
            <ul class="vm-profile__stockList">
              <% for art in lager.artikel: %>
                <% short = art.verfuegbar is null or (art.bestellt isnt null and art.verfuegbar < art.bestellt) %>
                <li class="vm-profile__stockItem">
                  <div class="vm-profile__stockHead">
                    <span class="vm-profile__stockNr"><%= art.artikelnummer %></span>
                    <span class="vm-profile__stockName" title="<%= art.name %>"><%= art.name %></span>
                  </div>
                  <div class="vm-profile__stockFigures">
                    <span class="vm-profile__stockBadge vm-profile__stockBadge--<%= if short then 'short' else 'ok' %>">
                      <%- @T('verfügbar') %> <%= if art.verfuegbar is null then '?' else art.verfuegbar %>
                    </span>
                    <% if art.bestellt isnt null: %><span class="vm-profile__muted"><%- @T('bestellt') %> <%= art.bestellt %></span><% end %>
                    <% if art.reserviert: %><span class="vm-profile__muted"><%- @T('reserviert') %> <%= art.reserviert %></span><% end %>
                  </div>
                  <% if art.lagerorte.length: %>
                    <div class="vm-profile__stockLocations">
                      <% for ort in art.lagerorte: %>
                        <span class="vm-profile__stockLocation<%= if ort.partnerlager then ' vm-profile__stockLocation--remote' else '' %>"><%= ort.lager %><% if ort.lagerplatz: %> / <%= ort.lagerplatz %><% end %>: <%= ort.menge %></span>
                      <% end %>
                    </div>
                  <% else: %>
                    <div class="vm-profile__muted"><%- @T('kein Bestand gebucht') %></div>
                  <% end %>
                  <% if art.zulauf is null: %>
                    <div class="vm-profile__hint"><%- @T('Einkauf konnte nicht gelesen werden, Zulauf unbekannt.') %></div>
                  <% else if art.zulauf.length: %>
                    <ul class="vm-profile__inbound">
                      <% for z in art.zulauf: %>
                        <li>
                          <div>
                            <% if z.link: %>
                              <a class="vm-profile__cta" href="<%= z.link %>" target="_blank" rel="noopener"><%- @T('Bestellung') %> <%= z.bestellung %></a>
                            <% else: %>
                              <span><%- @T('Bestellung') %> <%= z.bestellung %></span>
                            <% end %>
                            <span class="vm-profile__muted"><%= z.geliefert %> / <%= z.bestellt %> <%- @T('geliefert') %></span>
                          </div>
                          <div class="vm-profile__muted">
                            <% if z.lieferant: %><%= z.lieferant %> · <% end %><%= z.statusText %><% if z.datumFormatiert: %> · <%- @T('vom') %> <%= z.datumFormatiert %><% end %>
                          </div>
                          <% if z.lieferterminFormatiert: %>
                            <div class="vm-profile__inboundDate vm-profile__inboundDate--confirmed"><%- @T('Liefertermin bestätigt') %>: <%= z.lieferterminFormatiert %></div>
                          <% else: %>
                            <div class="vm-profile__inboundDate"><%- @T('Kein bestätigter Liefertermin') %><% if z.wunschterminFormatiert: %> (<%- @T('Wunschtermin') %> <%= z.wunschterminFormatiert %>)<% end %></div>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% else if short: %>
                    <div class="vm-profile__hint"><%- @T('Keine offene Einkaufsbestellung für diesen Artikel.') %></div>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <% if lager.weitereArtikel: %>
              <div class="vm-profile__muted"><%- @T('und') %> <%= lager.weitereArtikel %> <%- @T('weitere Artikel, siehe Auftrag in Xentral') %></div>
            <% end %>
            <% for hinweis in lager.hinweise: %>
              <div class="vm-profile__hint"><%= hinweis %></div>
            <% end %>
          </div>
        <% end %>
        <% if @data.passenderAuftrag.sendungen and @data.passenderAuftrag.sendungen.length: %>
          <ul class="vm-profile__shipments">
            <% for shipment in @data.passenderAuftrag.sendungen: %>
              <li>
                <% if shipment.trackingLink: %>
                  <a class="vm-profile__cta" href="<%= shipment.trackingLink %>" target="_blank" rel="noopener">
                    <%- @T('Sendung verfolgen') %><% if shipment.paketnummer: %> · <%= shipment.paketnummer %><% end %>
                  </a>
                <% else if shipment.paketnummer: %>
                  <span class="vm-profile__muted"><%= shipment.paketnummer %></span>
                <% end %>
                <% if shipment.lieferscheinLink: %>
                  <a class="vm-profile__cta" href="<%= shipment.lieferscheinLink %>" target="_blank" rel="noopener"><%- @T('Lieferschein') %></a>
                <% end %>
                <% if shipment.status: %>
                  <span class="vm-profile__shipmentStatus vm-profile__shipmentStatus--<%= shipment.statusKey %>"><%= shipment.status %></span>
                <% end %>
                <% if shipment.verlauf and shipment.verlauf.length: %>
                  <details class="vm-profile__history">
                    <summary><%- @T('Verlauf') %> (<%= shipment.verlauf.length %>)</summary>
                    <ul class="vm-profile__historyList">
                      <% for step in shipment.verlauf: %>
                        <li><span class="vm-profile__historyTime"><%= step.zeitpunkt %></span><%= step.status %></li>
                      <% end %>
                    </ul>
                  </details>
                <% end %>
                <% if shipment.quelle: %>
                  <div class="vm-profile__muted vm-profile__source"><%- @T('Quelle') %>: <%= shipment.quelle %></div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <% if @data.auftraege: %>
      <div class="vm-profile__section">
        <div class="vm-profile__sectionHead"><%- @T('Aufträge') %></div>
        <div class="vm-profile__stat">
          <span class="vm-profile__statValue"><%= @data.auftraege.anzahlGesamt %></span>
          <span class="vm-profile__statLabel"><%- @T('gesamt') %></span>
        </div>
        <div class="vm-profile__value">
          <%= @data.auftraege.wert.summeFormatiert %>
          <span class="vm-profile__muted">(<%= @data.auftraege.wert.beschriftung %>)</span>
        </div>
        <% if @data.auftraege.letzte.length: %>
          <ul class="vm-profile__orders">
            <% for order in @data.auftraege.letzte: %>
              <li>
                <% if order.link: %>
                  <a class="vm-profile__orderNr" href="<%= order.link %>" target="_blank" rel="noopener">#<%= order.auftragsnummer %></a>
                <% else: %>
                  <span class="vm-profile__orderNr">#<%= order.auftragsnummer %></span>
                <% end %>
                <span class="vm-profile__muted"><%= order.datum %></span>
                <span class="vm-profile__orderTotal"><%= order.summeFormatiert %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <% if @data.xentralStatus and @data.xentralStatus isnt 'ok': %>
      <div class="vm-profile__hint"><%= @data.xentralStatus %></div>
    <% end %>
  <% end %>
</div>
